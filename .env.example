# Copie ce fichier en ".env.local" pour travailler sur ton ordinateur.
# Sur Vercel, ces valeurs se mettent dans Settings > Environment Variables.

# Base de données Postgres (Neon). Vide en local : une base PGlite est créée dans .data/
DATABASE_URL=

# Adresse publique du site (liens dans les e-mails). Sur Vercel, facultatif : l'adresse du projet est détectée.
APP_URL=http://localhost:3000

# E-mails par SMTP. Gmail : ton adresse + un « mot de passe d'application » (pas ton mot de passe normal).
# Vide : les e-mails s'affichent dans la console (mode test).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="FactPay <ton-adresse@gmail.com>"

# Stockage des justificatifs (Vercel Blob). Vide en local : dossier .data/uploads
BLOB_READ_WRITE_TOKEN=

# Protège la tâche automatique quotidienne (/api/cron). Une longue chaîne aléatoire.
CRON_SECRET=
